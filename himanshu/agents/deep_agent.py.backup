@tool
def take_screenshot() -> str:
    """
    Capture a screenshot of the current page.
    
    Returns:
        Base64-encoded image data
    
    Useful for debugging or capturing page state.
    """
    try:
        result = asyncio.run(execute_browser_action("TAKE_SCREENSHOT", {}))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

@tool
def get_element_text(selector: str) -> str:
    """
    Get the text content of an element.
    
    Args:
        selector: CSS selector of the element
        
    Returns:
        Text content of the element
    
    Extracts visible text from the element and its children.
    """
    try:
        result = asyncio.run(execute_browser_action("GET_ELEMENT_TEXT", {"selector": selector}))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

@tool
def get_element_attributes(selector: str, attributes: Optional[List[str]] = None) -> str:
    """
    Get attributes of an element.
    
    Args:
        selector: CSS selector of the element
        attributes: List of attribute names to get (optional, gets all if not specified)
        
    Returns:
        Object with attribute name-value pairs
    
    Use to inspect element properties like href, src, class, id, etc.
    """
    try:
        result = asyncio.run(execute_browser_action("GET_ELEMENT_ATTRIBUTES", {
            "selector": selector,
            "attributes": attributes
        }))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

@tool
def execute_javascript(code: str) -> str:
    """
    Execute JavaScript code on the page.
    
    Args:
        code: JavaScript code to execute
        
    Returns:
        Result of the execution
    
    WARNING: Use with caution. For advanced scenarios only.
    Prefer specific tools when available.
    """
    try:
        result = asyncio.run(execute_browser_action("EXECUTE_JAVASCRIPT", {"code": code}))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

@tool
def get_local_storage(key: Optional[str] = None) -> str:
    """
    Get data from browser local storage.
    
    Args:
        key: Specific key to get (optional, gets all if not specified)
        
    Returns:
        Storage data
    
    Access persistent browser data storage.
    """
    try:
        result = asyncio.run(execute_browser_action("GET_LOCAL_STORAGE", {"key": key}))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

@tool
def set_local_storage(key: str, value: str) -> str:
    """
    Set data in browser local storage.
    
    Args:
        key: Storage key
        value: Value to store
        
    Returns:
        Success status
    
    Store persistent data in the browser.
    """
    try:
        result = asyncio.run(execute_browser_action("SET_LOCAL_STORAGE", {
            "key": key,
            "value": value
        }))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

# =================================================================
# TIMING & WAITING TOOLS
# =================================================================

@tool
def wait_for_element(selector: str, timeout: int = 5000) -> str:
    """
    Wait for an element to appear on the page.
    
    Args:
        selector: CSS selector to wait for
        timeout: Maximum wait time in milliseconds (default: 5000)
        
    Returns:
        Success status when element appears
    
    CRITICAL: Use after actions that trigger page changes or new content.
    Always wait before trying to interact with dynamically loaded elements.
    """
    try:
        result = asyncio.run(execute_browser_action("WAIT_FOR_ELEMENT", {
            "selector": selector,
            "timeout": timeout
        }))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

@tool
def scroll_page(direction: str = "down", amount: int = 500) -> str:
    """
    Scroll the page.
    
    Args:
        direction: "up" or "down" (default: "down")
        amount: Pixels to scroll (default: 500)
        
    Returns:
        Success status
    
    Use to reveal content below/above the viewport.
    Useful for infinite scroll pages or long content.
    """
    try:
        result = asyncio.run(execute_browser_action("SCROLL_PAGE", {
            "direction": direction,
            "amount": amount
        }))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

@tool
def find_elements(selector: str, filter_visible: bool = True) -> str:
    """
    Find all matching elements on the page.
    
    Args:
        selector: CSS selector to search for
        filter_visible: Only return visible elements (default: True)
        
    Returns:
        JSON array with information about matching elements
    
    Use this to discover multiple instances of elements.
    """
    try:
        result = asyncio.run(execute_browser_action("FIND_ELEMENTS", {
            "selector": selector,
            "filter_visible": filter_visible
        }))
        return json.dumps(result, indent=2)
    except Exception as e:
        return json.dumps({"success": False, "error": str(e)})

# =================================================================
# SYSTEM PROMPT FOR DEEP AGENT
# =================================================================

DEEP_AGENT_SYSTEM_PROMPT = """You are an advanced web automation AI agent with comprehensive browser control, planning capabilities, and access to specialized tools.

CORE CAPABILITIES:
1. PLANNING: Use write_todos to break complex tasks into manageable steps
2. CONTEXT MANAGEMENT: Use file system tools (ls, read_file, write_file, edit_file) for large data
3. SUBAGENT SPAWNING: Use task tool to delegate specialized work
4. BROWSER AUTOMATION: 30+ tools for web interaction
5. DOM ANALYSIS: Specialized sub-agent for page structure understanding

BUILT-IN DEEP AGENT TOOLS (automatically available):
- write_todos: Create/update task list for complex workflows
- ls: List files in agent's filesystem
- read_file: Read file contents for context
- write_file: Save data to files
- edit_file: Modify existing files
- task: Spawn subagent for specialized tasks

BROWSER AUTOMATION TOOLS:
- DOM Expert: analyze_page_with_dom_expert (use FIRST for complex pages)
- Page Analysis: get_page_info, extract_dom_structure, find_elements, get_element_text, take_screenshot
- Interactions: click_element, type_text, fill_form_fields, select_dropdown_option, hover_element
- Navigation: open_new_tab, switch_tab, navigate_to_url, go_back, reload_page, close_current_tab
- Data: get_local_storage, set_local_storage, execute_javascript, get_element_attributes
- Timing: wait_for_element, scroll_page
- Google: get_user_info, get_calendar_events, get_latest_emails, search_emails

WORKFLOW FOR COMPLEX TASKS:
1. Break down request: Use write_todos to create step-by-step plan
2. Analyze page: Call analyze_page_with_dom_expert for complex pages
3. Save large data: Write DOM/response data to files if > 1000 chars
4. Delegate work: Use task tool for independent subtasks
5. Execute systematically: Follow todos, validate each step
6. Manage context: Read from files to recall saved information

WHEN TO USE DEEP AGENT FEATURES:
✓ Complex multi-step workflows → write_todos
✓ Large API responses or DOM data → write_file, read_file
✓ Need to remember data across steps → write_file
✓ Independent subtask (e.g., "research X") → task tool
✓ Need to track progress → write_todos
✗ Simple single-step tasks → just use browser tools

WHEN TO USE DOM EXPERT:
✓ First time visiting complex website
✓ Need to find specific interactive elements
✓ Analyzing forms or multi-step workflows
✓ Unsure what actions are possible
✗ Simple tasks like "go to URL" or "take screenshot"

BEST PRACTICES:
✓ Parse JSON results: data = json.loads(result)
✓ Check success: if data.get("success")
✓ Wait after clicks: wait_for_element(selector, timeout=5000)
✓ Use specific selectors from page analysis
✓ Verify each step before proceeding
✓ Save large data to files
✓ Update todos as you complete steps
✗ Don't assume elements exist without checking
✗ Don't skip wait times after page changes
✗ Don't ignore tool errors
✗ Don't keep large data in memory

EXAMPLE: Complex Task Flow
User: "Research competitor pricing from 3 websites and create a comparison"

1. write_todos: ["Visit site 1", "Extract pricing", "Save to file", "Visit site 2", ...]
2. navigate_to_url: "https://competitor1.com"
3. analyze_page_with_dom_expert: "Find pricing information and tables"
4. write_file: Save extracted pricing to "competitor1_pricing.json"
5. navigate_to_url: "https://competitor2.com"
6. ... (repeat for other sites)
7. read_file: Load all saved pricing data
8. task: "Create comparison table from this data: ..." (delegate analysis)

Execute methodically with planning, validate each step, manage context efficiently, provide clear feedback."""

# Collect all tools
tools = [
    # DOM Analysis Sub-Agent
    analyze_page_with_dom_expert,
    # Page Analysis
    get_page_info,
    extract_dom_structure,
    find_elements,
    get_element_text,
    get_element_attributes,
    take_screenshot,
    # Interactions
    click_element,
    type_text,
    fill_form_fields,
    select_dropdown_option,
    hover_element,
    # Navigation
    navigate_to_url,
    open_new_tab,
    close_current_tab,
    switch_tab,
    get_all_tabs,
    reload_page,
    go_back,
    go_forward,
    # Data & Utility
    execute_javascript,
    get_local_storage,
    set_local_storage,
    # Timing
    wait_for_element,
    scroll_page,
    # Google API tools
    *google_tools,
]

# Create deep agent
agent = create_deep_agent(
    model=llm,
    tools=tools,
    system_prompt=DEEP_AGENT_SYSTEM_PROMPT
)

logger.info(f"✅ Deep agent created with {len(tools)} custom tools + built-in planning/filesystem/subagent tools")
